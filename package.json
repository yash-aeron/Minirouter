{
  "name": "miniroute",
  "version": "0.1.0",
  "description": "Local AI gateway/router: one OpenAI/Anthropic-compatible endpoint, many providers, automatic fallback",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yash-aeron/Minirouter.git"
  },
  "bugs": {
    "url": "https://github.com/yash-aeron/Minirouter/issues"
  },
  "homepage": "https://github.com/yash-aeron/Minirouter#readme",
  "keywords": [
    "llm",
    "ai-gateway",
    "router",
    "openai",
    "anthropic",
    "claude-code",
    "codex",
    "gemini",
    "failover",
    "proxy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "miniroute": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "commander": "^12.1.0",
    "hono": "^4.6.0",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
